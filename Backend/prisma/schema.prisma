  password     String
  name         String  @default("")
  phone        String  @default("")
  profileImage String  @default("")

  fcmTokens      String[]
  fcmTokenMobile String[]

  role      String    @default("ADMIN")
  adminType AdminType @default(super_admin)

  /// Section → allowed actions. Sections come from constants/permissions.js,
