/// A support conversation thread. Messages remain the source of truth for
/// lastMessage / lastAt / unread — this row only holds the extra lifecycle state
/// (subject, status) that no individual message carries.
model FoodChatConversation {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  /// Same deterministic id the messages carry, so the two join cleanly.
  conversationId String @unique

  orderId String? @db.VarChar(24)

  /// Subject the user picked, e.g. "I want to cancel my order".
  title String @default("") @db.VarChar(200)

  status ChatThreadStatus @default(open)
  /// Only set once status becomes 'closed'; cleared if reopened.
  closedAt DateTime?

  /// Who the opener is talking to: 'ADMIN' or 'DELIVERY_PARTNER:<id>'.
  peerToken     String
  /// The party that opened the thread, same token form.
  openedByToken String
  participants  String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order FoodOrder? @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt(sort: Desc)])
  @@index([status])
  @@map("food_chat_conversations")
}

/// One chat message. A "party token" identifies a participant:
///   USER:<id> | RESTAURANT:<id> | DELIVERY_PARTNER:<id> | ADMIN
/// ADMIN is a single logical endpoint — any admin can read or reply, so its token
/// carries no id, while senderId still records the real admin for audit.
model FoodChatMessage {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  conversationId String
  orderId        String? @db.VarChar(24)

  senderRole  ChatRole
  senderId    String   @db.VarChar(24)
  senderToken String

  recipientRole  ChatRole
  recipientId    String?  @db.VarChar(24)
  recipientToken String

  /// [senderToken, recipientToken] — finds "my conversations" with one indexed match.
  participants String[]

  text   String    @db.VarChar(2000)
  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order FoodOrder? @relation(fields: [orderId], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([recipientToken, readAt])
  @@index([orderId])
  @@map("food_chat_messages")
}

/// ponytail: had a 7-day TTL index in Mongo. Postgres needs a scheduled delete —
/// see constraints.sql.
model FoodNotification {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  ownerType OwnerType
  ownerId   String    @db.VarChar(24)

  title    String
  message  String
  link     String @default("")
  category String @default("broadcast")

  source      NotificationSource @default(ADMIN_BROADCAST)
  broadcastId String?            @db.VarChar(24)

  metadata Json @default("{}")

  isRead      Boolean   @default(false)
  readAt      DateTime?
  dismissedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  broadcast NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  /// One notification per recipient per broadcast — the fan-out is idempotent.
  @@unique([broadcastId, ownerType, ownerId])
  @@index([ownerType, ownerId, createdAt(sort: Desc)])
  @@index([ownerType, ownerId, isRead, dismissedAt])
  @@index([createdAt])
  @@map("food_notifications")
}

model NotificationBroadcast {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  title   String
  message String

  targetType BroadcastTargetType
  /// ponytail: id array, matching the Mongo access pattern.
  targetIds  String[]
  /// [{ ownerType, ownerId, label, subLabel }] — display snapshot of the audience.
  targets    Json                @default("[]")

  link        String @default("")
  createdById String @db.VarChar(24)
  targetCount Int    @default(0)

  createdAt DateTime @default(now())

  createdBy     FoodAdmin          @relation(fields: [createdById], references: [id])
  notifications FoodNotification[]

  @@index([targetType])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
  @@map("food_notification_broadcasts")
}

model FeedbackExperience {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

