// ─────────────────────────────────────────────────────────────────────────────
// Auth — OTP and refresh tokens
// ─────────────────────────────────────────────────────────────────────────────

/// ponytail: Postgres has no TTL index. purgeAt/expiresAt rows must be swept by
/// the existing maintenance worker (see constraints.sql for the delete statements).
model FoodOtp {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  phone     String   @db.VarChar(20)
  otp       String   @db.VarChar(10)
  expiresAt DateTime

  attempts      Int      @default(0)
  requestCount  Int      @default(1)
  lastRequestAt DateTime @default(now())

  /// Fixed rate-limit window anchor. Deliberately not lastRequestAt — a sliding
  /// anchor let spaced requests accumulate forever and lock out real users.
  windowStartedAt DateTime @default(now())

  /// Reap time. Distinct from expiresAt (OTP validity) so the rate-limit counter
  /// outlives the OTP and the per-phone quota is actually enforceable.
  purgeAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([purgeAt])
  @@map("food_otps")
}

model AdminResetOtp {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  email     String   @db.VarChar(255)
  otp       String   @db.VarChar(10)
  expiresAt DateTime
  attempts  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@map("food_admin_reset_otps")
}

model FoodRefreshToken {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  userId    String   @db.VarChar(24)
  token     String   @unique
  device    String?
  ipAddress String?
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("food_refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Money — wallets, ledger, payments, refunds, settlements
// ─────────────────────────────────────────────────────────────────────────────

/// One table for all four wallet types. Mongo had four models that
/// transaction.service.js already unified behind a resolveWallet() switch —
/// this deletes that switch. Admin is the singleton row
/// entityId = '000000000000000000000001'. Columns that only apply to some
/// entity types are nullable.
model Wallet {
  entityType   EntityType
  entityId     String     @db.VarChar(24)
  balance      Decimal    @default(0) @db.Decimal(14, 2)
  lockedAmount Decimal    @default(0) @db.Decimal(14, 2)

  // restaurant + deliveryBoy
  totalEarnings Decimal? @db.Decimal(14, 2)
  totalSettled  Decimal? @db.Decimal(14, 2)

  // deliveryBoy only
  cashInHand      Decimal? @db.Decimal(14, 2)
  totalBonus      Decimal? @db.Decimal(14, 2)
  totalDeliveries Int?

  // user only
  referralEarnings Decimal? @db.Decimal(14, 2)

  // admin only
  totalRevenue Decimal? @db.Decimal(14, 2)
  totalPayouts Decimal? @db.Decimal(14, 2)
  totalRefunds Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@id([entityType, entityId])
  @@map("wallets")
}

/// Universal financial ledger — single source of truth for money movement.
/// Never write Wallet.balance except through recordTransaction().
model Transaction {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  paymentId String? @db.VarChar(24)
  orderId   String? @db.VarChar(24)

  entityType EntityType
  entityId   String     @db.VarChar(24)

  type         TxnType
  amount       Decimal   @db.Decimal(14, 2)
  balanceAfter Decimal   @db.Decimal(14, 2)
  currency     String    @default("INR") @db.VarChar(3)
  status       TxnStatus @default(completed)

  description String      @default("")
  category    TxnCategory @default(other)
  module      String      @default("food")
  metadata    Json?

  /// Set by callers that can be retried (gateway webhooks, queue jobs).
  /// Unique — a replay returns the original row instead of double-crediting.
  idempotencyKey String? @unique

  /// Replaces Settlement.transactionIds[] — the array is now this FK.
  settlementId String? @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet     Wallet      @relation(fields: [entityType, entityId], references: [entityType, entityId])
  payment    Payment?    @relation(fields: [paymentId], references: [id])
  order      FoodOrder?  @relation(fields: [orderId], references: [id])
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([orderId, entityType])
  @@index([paymentId, type])
  @@index([settlementId])
  @@map("transactions")
}

model Payment {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  orderId String @db.VarChar(24)
  userId  String @db.VarChar(24)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("INR") @db.VarChar(3)

  method  PaymentMethod
  gateway PaymentGateway @default(none)

  gatewayOrderId   String? @db.VarChar(128)
  gatewayPaymentId String? @db.VarChar(128)

  status PaymentStatus @default(created)
  module String        @default("food")

  /// Full gateway response snapshot — audit/support only, never sent to clients.
  rawResponse Json?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order FoodOrder @relation(fields: [orderId], references: [id])
  user  FoodUser  @relation(fields: [userId], references: [id])

  transactions Transaction[]
  refunds      Refund[]

  @@index([orderId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([module])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model Refund {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  paymentId String @db.VarChar(24)
  orderId   String @db.VarChar(24)
  userId    String @db.VarChar(24)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("INR") @db.VarChar(3)
  reason   String  @default("")

  status   RefundStatus @default(pending)
  refundTo RefundTo     @default(wallet)

  gatewayRefundId String? @db.VarChar(128)

  processedAt DateTime?
  processedBy String?   @db.VarChar(24)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment   @relation(fields: [paymentId], references: [id])
  order   FoodOrder @relation(fields: [orderId], references: [id])
  user    FoodUser  @relation(fields: [userId], references: [id])

  @@index([paymentId])
  @@index([userId])
  @@index([orderId, status])
  @@map("refunds")
}

model Settlement {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  entityType EntityType
  entityId   String     @db.VarChar(24)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("INR") @db.VarChar(3)

  status    SettlementStatus @default(pending)
  payoutRef String           @default("")

  processedAt DateTime?
  processedBy String?   @db.VarChar(24)

  periodStart DateTime?
  periodEnd   DateTime?

  notes    String @default("")
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([entityType, entityId, status, createdAt(sort: Desc)])
  @@map("settlements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

model FoodOrder {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  /// Display id, "FOD-<6 ts digits><4 random>". Generated in the order service —
  /// the pre('save') collision retry moves there.
  order_id String? @unique @db.VarChar(32)
  /// ponytail: existed only to satisfy a rogue Mongo index 'orderId_1'. Droppable
  /// once the frontend is confirmed to read order_id only.
  orderId  String? @unique @db.VarChar(32)

  userId        String  @db.VarChar(24)
  restaurantId  String  @db.VarChar(24)
  zoneId        String? @db.VarChar(24)
  transactionId String? @db.VarChar(24)

  customerName  String @default("")
  customerPhone String @default("")

  // ── delivery address (was an embedded subdoc) ──
  addrLabel             AddressLabel @default(Home)
  addrName              String       @default("")
  addrFullName          String       @default("")
  addrStreet            String
  addrAdditionalDetails String       @default("")
  addrCity              String
  addrState             String
  addrZipCode           String       @default("")
  addrPhone             String       @default("")
  /// Plain lat/lng is what application code reads — Prisma Client cannot select an
  /// Unsupported column, and buildLiveEta/buildDeliverySocketPayload need the point
  /// on every order fetch. The geography column below is kept in sync by a trigger
  /// and exists purely so GIST/ST_DWithin queries work.
  addrLat               Float?
  addrLng               Float?
  addrLocation          Unsupported("geography(Point, 4326)")?

  // ── pricing (was an embedded subdoc; flattened so revenue SQL stays simple) ──
  subtotal             Decimal      @db.Decimal(14, 2)
  tax                  Decimal      @default(0) @db.Decimal(14, 2)
  packagingFee         Decimal      @default(0) @db.Decimal(14, 2)
  deliveryFee          Decimal      @default(0) @db.Decimal(14, 2)
  deliveryFeeGst       Decimal      @default(0) @db.Decimal(14, 2)
  platformFee          Decimal      @default(0) @db.Decimal(14, 2)
  /// Quick Mode surcharge; also included in platformFee.
  quickDeliveryFee     Decimal      @default(0) @db.Decimal(14, 2)
  deliveryMode         DeliveryMode @default(basic)
  restaurantCommission Decimal      @default(0) @db.Decimal(14, 2)
  discount             Decimal      @default(0) @db.Decimal(14, 2)
  couponCode           String?      @db.VarChar(64)
  total                Decimal      @db.Decimal(14, 2)
  currency             String       @default("INR") @db.VarChar(3)
  /// Straight-line restaurant ↔ customer km, used for fee calculation.
  distanceKm           Decimal?     @db.Decimal(8, 2)
  /// Driving km / minutes from the Directions API.
  roadDistanceKm       Decimal?     @db.Decimal(8, 2)
  roadDurationMins     Int?

  // ── payment snapshot (audit trail lives in Payment/Transaction) ──
  paymentMethod    OrderPaymentMethod
  paymentStatus    OrderPaymentStatus @default(cod_pending)
  paymentAmountDue Decimal?           @db.Decimal(14, 2)
  razorpayOrderId  String?
  razorpayPaymentId String?
  razorpaySignature String?
  /// QR checkout details — written once, never filtered on.
  qr               Json?
  refundStatus     OrderRefundStatus  @default(none)
  refundAmount     Decimal            @default(0) @db.Decimal(14, 2)
  refundId         String             @default("")
  refundProcessedAt DateTime?

  orderStatus OrderStatus @default(created)

  // ── dispatch ──
  dispatchStatus            DispatchStatus @default(unassigned)
  dispatchDeliveryPartnerId String?        @db.VarChar(24)
  dispatchAssignedAt        DateTime?
  dispatchAcceptedAt        DateTime?
  dispatchingAt             DateTime?

  // ── delivery state ──
  deliveryPhase   DeliveryPhase @default(en_route_to_pickup)
  deliveryStatus  String        @default("")
  reachedPickupAt DateTime?
  reachedDropAt   DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  /// Photo of the restaurant bill, uploaded by the rider at pickup. The Mongoose
  /// deliveryState sub-schema had no such field, so strict mode dropped it on
  /// every save and the upload was never actually stored.
  billImageUrl    String?

  // ── ratings given on this order ──
  restaurantRating        Int?
  restaurantRatingComment String    @default("")
  restaurantRatedAt       DateTime?
  partnerRating           Int?
  partnerRatingComment    String    @default("")
  partnerRatedAt          DateTime?
  /// The customer, rated by the delivery partner after handover.
  customerRating          Int?
  customerRatingComment   String    @default("")
  customerRatedAt         DateTime?

  note                 String @default("")
  deliveryInstructions String @default("")

  acceptanceWindowSeconds Int       @default(240)
  acceptanceDeadlineAt    DateTime?
  /// Idempotency guard so retries never double-push the "new order" alert.
  restaurantNotifiedAt    DateTime?

  sendCutlery    Boolean   @default(true)
  deliveryFleet  String    @default("standard")
  scheduledAt    DateTime?

  riderEarning Decimal @default(0) @db.Decimal(14, 2)
  /// Can be negative when discounts/rider pay exceed platform income.
  platformProfit Decimal @default(0) @db.Decimal(14, 2)

  tripDistanceKm   Decimal? @db.Decimal(8, 2)
  tripDurationMins Int?

  /// Plain 4-digit handover OTP; cleared after verify. Never return to the partner.
  deliveryOtp        String  @default("") @db.VarChar(8)
  dropOtpRequired    Boolean @default(false)
  dropOtpVerified    Boolean @default(false)

  riderLat          Float?
  riderLng          Float?
  lastRiderLocation Unsupported("geography(Point, 4326)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            FoodUser             @relation(fields: [userId], references: [id])
  restaurant      FoodRestaurant       @relation(fields: [restaurantId], references: [id])
  zone            FoodZone?            @relation(fields: [zoneId], references: [id])
  deliveryPartner FoodDeliveryPartner? @relation(fields: [dispatchDeliveryPartnerId], references: [id])

  items          OrderItem[]
  itemRatings    OrderItemRating[]
  statusHistory  OrderStatusHistory[]
  dispatchOffers OrderDispatchOffer[]

  payments          Payment[]
  refunds           Refund[]
  transactions      Transaction[]
  foodTransaction   FoodTransaction?
  chatMessages      FoodChatMessage[]
  chatConversations FoodChatConversation[]
  supportTickets    FoodSupportTicket[]
  emergencyRequests DeliveryOrderEmergencyRequest[]

  @@index([createdAt(sort: Desc)])
  @@index([orderStatus, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([restaurantId, orderStatus, createdAt(sort: Desc)])
  @@index([dispatchDeliveryPartnerId, orderStatus])
  @@index([dispatchStatus, orderStatus])
  @@index([dispatchStatus, orderStatus, updatedAt(sort: Desc)])
  @@index([dispatchDeliveryPartnerId, dispatchStatus, updatedAt(sort: Desc)])
  @@index([paymentStatus, createdAt(sort: Desc)])
  @@index([paymentMethod, createdAt(sort: Desc)])
  @@index([zoneId])
  @@map("food_orders")
}

/// One line on an order. Prices are recorded, not derived — the customer must
/// keep being shown what they were actually charged even after the menu changes.
model OrderItem {
  id      String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  orderId String @db.VarChar(24)

  itemId       String
  name         String
  variantId    String  @default("")
  variantName  String  @default("")
  variantPrice Decimal @default(0) @db.Decimal(14, 2)
  price        Decimal @db.Decimal(14, 2)
  /// Compare-at / other-platform unit price snapshot at order time.
  otherPrice   Decimal @default(0) @db.Decimal(14, 2)
  quantity     Int
  isVeg        Boolean @default(true)
  image        String  @default("")
  notes        String  @default("")

  /// [{ addonId, name, price }] as chosen and priced at order time. Already folded
  /// into `price`. Json rather than a table — written once, never queried across orders.
  addons Json @default("[]")

  order FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemId])
  @@map("food_order_items")
}

/// Per-dish rating from the customer. itemId matches OrderItem.itemId.
model OrderItemRating {
  id      String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  orderId String @db.VarChar(24)

  itemId  String
  name    String   @default("")
  rating  Int
  comment String   @default("")
  ratedAt DateTime @default(now())

  order FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([itemId])
  @@map("food_order_item_ratings")
}

model OrderStatusHistory {
  id      String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  orderId String @db.VarChar(24)

  at     DateTime   @default(now())
  byRole ActorRole?
  byId   String?    @db.VarChar(24)
  from   String?
  to     String?
  note   String     @default("")

  order FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at(sort: Desc)])
  @@map("food_order_status_history")
}

/// Partners this order was offered to — prevents repeat offers and tracks timeouts.
model OrderDispatchOffer {
  id      String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  orderId String @db.VarChar(24)

  partnerId String              @db.VarChar(24)
  at        DateTime            @default(now())
  action    DispatchOfferAction @default(offered)

  order   FoodOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partner FoodDeliveryPartner @relation(fields: [partnerId], references: [id])

  @@index([orderId, at(sort: Desc)])
  @@index([partnerId])
  @@map("food_order_dispatch_offers")
}

/// Per-order financial split. Distinct from Transaction (the wallet ledger):
/// this is the one-row-per-order breakdown finance reports against.
model FoodTransaction {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  orderId           String  @unique @db.VarChar(24)
  userId            String  @db.VarChar(24)
  restaurantId      String  @db.VarChar(24)
  deliveryPartnerId String? @db.VarChar(24)

  paymentMethod OrderPaymentMethod
  status        FoodTxnStatus      @default(pending)
  currency      String             @default("INR") @db.VarChar(3)

  // ── order pricing snapshot at transaction creation ──
  subtotal             Decimal @default(0) @db.Decimal(14, 2)
  tax                  Decimal @default(0) @db.Decimal(14, 2)
  packagingFee         Decimal @default(0) @db.Decimal(14, 2)
  deliveryFee          Decimal @default(0) @db.Decimal(14, 2)
  deliveryFeeGst       Decimal @default(0) @db.Decimal(14, 2)
  platformFee          Decimal @default(0) @db.Decimal(14, 2)
  restaurantCommission Decimal @default(0) @db.Decimal(14, 2)
  discount             Decimal @default(0) @db.Decimal(14, 2)
  couponCode           String? @db.VarChar(64)
  total                Decimal @default(0) @db.Decimal(14, 2)

  // ── payment state snapshot ──
  /// Free-text mirror of the order's payment.status ('cod_pending', 'pending_qr',
  /// 'paid'…). Distinct from `status`, which is the transaction's own lifecycle.
  paymentStatusLabel String  @default("cod_pending")
  amountDue          Decimal @default(0) @db.Decimal(14, 2)

  gatewayProvider   String  @default("razorpay")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  /// Payment-link / QR snapshot: { qrId, imageUrl, paymentLinkId, shortUrl, status, expiresAt }.
  qr                Json?

  // ── the split ──
  totalCustomerPaid   Decimal @db.Decimal(14, 2)
  restaurantShare     Decimal @db.Decimal(14, 2)
  commissionAmount    Decimal @db.Decimal(14, 2)
  riderShare          Decimal @db.Decimal(14, 2)
  /// Can be negative when discounts/rider pay exceed platform income.
  platformNetProfit   Decimal @db.Decimal(14, 2)
  taxAmount           Decimal @default(0) @db.Decimal(14, 2)
  adminDiscountShare  Decimal @default(0) @db.Decimal(14, 2)
  restaurantDiscountShare Decimal @default(0) @db.Decimal(14, 2)
  discountAdminBearPercentage      Decimal @default(0) @db.Decimal(5, 2)
  discountRestaurantBearPercentage Decimal @default(0) @db.Decimal(5, 2)

  // ── settlement tracking ──
  isRestaurantSettled Boolean   @default(false)
  restaurantSettledAt DateTime?
  isRiderSettled      Boolean   @default(false)
  riderSettledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order           FoodOrder            @relation(fields: [orderId], references: [id])
  restaurant      FoodRestaurant       @relation(fields: [restaurantId], references: [id])
  deliveryPartner FoodDeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])

  history FoodTransactionHistory[]

  @@index([userId])
  @@index([restaurantId])
  @@index([deliveryPartnerId])
  @@index([createdAt(sort: Desc)])
  @@index([isRestaurantSettled, restaurantId])
  @@index([status, paymentMethod])
  @@map("food_transactions")
}

model FoodTransactionHistory {
  id            String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  transactionId String @db.VarChar(24)

  /// 'created' | 'authorized' | 'captured' | 'refunded' | 'settled'
  kind           String
  amount         Decimal?   @db.Decimal(14, 2)
  at             DateTime   @default(now())
  note           String     @default("")
  recordedByRole ActorRole?
  recordedById   String?    @db.VarChar(24)

  transaction FoodTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, at(sort: Desc)])
  @@map("food_transaction_history")
}

model FoodSettings {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  key             String    @unique
  dispatchMode    String    @default("auto")
  updatedByRole   String?
  updatedByAdminId String?  @db.VarChar(24)
  updatedAtBy     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("food_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Menu — items, categories, add-ons
// ─────────────────────────────────────────────────────────────────────────────

model FoodItem {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  restaurantId String  @db.VarChar(24)
  categoryId   String? @db.VarChar(24)
  categoryName String  @default("")

  name        String
  description String  @default("")
  price       Decimal @db.Decimal(14, 2)
  /// Compare-at / other-platform price for strikethrough UI.
  otherPrice  Decimal @default(0) @db.Decimal(14, 2)

  /// [{ id, name, price, otherPrice }] — sized per restaurant, never queried across items.
  variants Json @default("[]")

  /// Primary image, also the first entry of `images`. Kept as its own column
  /// because the user app, admin list, share previews and push payloads all read it.
  image  String   @default("")
  images String[]

  foodType    FoodType @default(NonVeg)
  isAvailable Boolean  @default(true)

  rating       Decimal @default(0) @db.Decimal(2, 1)
  totalRatings Int     @default(0)

  /// When set, the item auto-restores to available after this time.
  stockResumeAt DateTime?
  stockOffMode  StockOffMode?

  isRecommended   Boolean @default(false)
  preparationTime String  @default("")

  approvalStatus  ApprovalStatus @default(approved)
  rejectionReason String         @default("")
  requestedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   FoodCategory?  @relation(fields: [categoryId], references: [id])

  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([approvalStatus, createdAt(sort: Desc)])
  @@index([approvalStatus, requestedAt(sort: Desc)])
  @@index([restaurantId, approvalStatus, createdAt(sort: Desc)])
  @@index([name])
  @@index([isAvailable])
  @@index([isRecommended])
  @@index([stockResumeAt])
  @@index([categoryId])
  @@map("food_items")
}

model FoodCategory {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  name          String
  image         String        @default("")
  type          String        @default("")
  foodTypeScope FoodTypeScope @default(Both)

  /// Null = admin/global category, shareable across restaurants.
  /// Set = private to that restaurant. Approval moderates content; it does not
  /// make a restaurant-owned category globally reusable.
  restaurantId            String? @db.VarChar(24)
  createdByRestaurantId   String? @db.VarChar(24)

  approvalStatus  ApprovalStatus @default(approved)
  isApproved      Boolean        @default(true)
  rejectionReason String         @default("")
  requestedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  globalizedAt    DateTime?

  /// Set = visible only in that zone. Null = visible everywhere.
  zoneId String? @db.VarChar(24)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant          FoodRestaurant? @relation("CategoryOwner", fields: [restaurantId], references: [id])
  createdByRestaurant FoodRestaurant? @relation("CategoryCreator", fields: [createdByRestaurantId], references: [id])
  zone                FoodZone?       @relation(fields: [zoneId], references: [id])

  foodItems FoodItem[]

  @@index([name])
  @@index([isApproved, createdAt(sort: Desc)])
  @@index([restaurantId, isApproved, createdAt(sort: Desc)])
  @@index([approvalStatus, createdAt(sort: Desc)])
  @@index([createdByRestaurantId, createdAt(sort: Desc)])
  @@index([zoneId])
  @@index([isActive, sortOrder])
  @@map("food_categories")
}

model FoodAddon {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  restaurantId String @db.VarChar(24)

  /// Menu items this add-on attaches to. EMPTY MEANS RESTAURANT-WIDE.
  /// ponytail: array of ids rather than a join table, matching the Mongo access
  /// pattern exactly. Needs a GIN index (see constraints.sql). Promote to a join
  /// table if referential integrity on these ever matters.
  foodIds String[]

  // ── grouping rules, so the app can render "Select up to 1 option" sheets ──
  /// Empty = ungrouped; shown under a generic "Add-ons" heading.
  groupName      String @default("")
  /// > 0 makes the group mandatory before the item can be added to the cart.
  groupMinSelect Int    @default(0)
  /// 1 renders radio buttons, >1 renders checkboxes capped at this count.
  groupMaxSelect Int    @default(1)
  groupSortOrder Int    @default(0)

  /// { name, description, foodType, price, image, images } — what the restaurant
  /// edits and admin approves.
  draft     Json
  /// Same shape; what the user app sees while a draft is pending. Null until first approval.
  published Json?

  approvalStatus  ApprovalStatus @default(pending)
  rejectionReason String         @default("")
  requestedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?

  isAvailable Boolean @default(true)
  /// Soft delete, for safety and auditability.
  isDeleted   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isDeleted, createdAt(sort: Desc)])
  @@index([approvalStatus, isDeleted, requestedAt(sort: Desc)])
  @@index([restaurantId, approvalStatus, isDeleted, requestedAt(sort: Desc)])
  @@index([restaurantId, approvalStatus, isAvailable])
  @@map("food_addons")
}

model FoodRestaurantMenu {
  id           String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  restaurantId String @unique @db.VarChar(24)

  /// Stored as-is for the UI; validated at the service layer.
  sections Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("food_restaurant_menus")
}

model FoodRestaurantOutletTimings {
  id           String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  restaurantId String @unique @db.VarChar(24)

  /// [{ day, isOpen, openingTime: "HH:mm", closingTime: "HH:mm" }] — always read
  /// as a whole set, never filtered by day in SQL.
  timings Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant FoodRestaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("food_restaurant_outlet_timings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart and favourites
// ─────────────────────────────────────────────────────────────────────────────

model FoodUserCart {
  id     String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  userId String @unique @db.VarChar(24)

  restaurantId   String @default("") @db.VarChar(24)
  restaurantName String @default("")

  /// Line items, replaced wholesale on every cart write.
  items     Json @default("[]")
  itemCount Int  @default(0)

  subtotal Decimal @default(0) @db.Decimal(14, 2)
  /// Full quote incl. fee breakdown and applied coupon. Recomputed, never queried.
  pricing  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user FoodUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt(sort: Desc)])
  @@index([restaurantId])
  @@map("food_user_carts")
}

/// One favourited restaurant or dish. Its own table rather than an array on
/// FoodUser so a favourite is one atomic write and rapid taps cannot interleave
/// into a lost update.
model FoodUserFavorite {
  id     String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  userId String @db.VarChar(24)

  entityType FavoriteEntity
  entityId   String         @db.VarChar(24)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user FoodUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The duplicate guard: a double-tapped heart fires two adds; without this the
  /// second inserts a second row and one un-favourite leaves it still favourited.
  @@unique([userId, entityType, entityId])
  @@index([userId, entityType, createdAt(sort: Desc)])
  @@map("food_user_favorites")
}

enum FavoriteEntity {
  restaurant
  food
