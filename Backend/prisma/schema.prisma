/// Cashback is awarded once per order on delivery and credited to the customer's
/// wallet as a normal transaction with metadata.source = 'cashback' — the wallet
/// ledger IS the record, there is no separate cashback ledger.
model FoodCashbackSettings {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  isEnabled Boolean @default(false)
  /// percentage → percent of item subtotal; flat → fixed rupees
  cashbackType  CashbackType @default(percentage)
  cashbackValue Decimal      @default(0) @db.Decimal(14, 2)

  /// Order subtotal must reach this to qualify.
  minOrderValue Decimal @default(0) @db.Decimal(14, 2)
  /// Cap in rupees for a percentage award. 0 = uncapped.
  maxCashback   Decimal @default(0) @db.Decimal(14, 2)

  /// Only the customer's first ever delivered order qualifies.
  firstOrderOnly Boolean @default(false)
  /// Max awards per customer overall. 0 = unlimited.
  perUserLimit   Int     @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt(sort: Desc)])
  @@map("food_cashback_settings")
}

