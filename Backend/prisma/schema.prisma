// Switcheats — full Postgres schema, translated from the 72 Mongoose models.
//
// Conventions applied throughout:
//   * ids stay 24-char hex so the frontend's /^[a-f0-9]{24}$/ checks keep working
//   * money is Decimal(14,2), never Float — Mongo stored every rupee as a JS float
//   * closed enums become Postgres enums; @map covers values Prisma can't name
//   * scalar arrays use native Postgres arrays instead of join tables
//   * snapshot/config blobs stay Json; anything filtered or aggregated is a column
//   * geo columns are PostGIS and invisible to Prisma Client — use $queryRaw
//
// See constraints.sql for CHECKs, extensions, and the TTL replacements.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis]
}

