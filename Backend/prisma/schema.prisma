// ─────────────────────────────────────────────────────────────────────────────
// Subscriptions and billing
// ─────────────────────────────────────────────────────────────────────────────

/// One invoice per restaurant per calendar billing month (postpaid). GMV, plan
/// and amounts freeze at generation; settlement only moves paid/waived/adjustment
/// via appended FoodSubscriptionTransaction rows. billingMonth 'legacy' holds
/// pre-migration carried-forward dues.
model FoodSubscriptionInvoice {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  restaurantId String @db.VarChar(24)
  /// 'YYYY-MM' or 'legacy'
  billingMonth String @db.VarChar(16)

  periodStart DateTime?
  periodEnd   DateTime?

  gmv        Decimal          @default(0) @db.Decimal(14, 2)
  orderCount Int              @default(0)
  planName   SubscriptionPlan
  planAmount Decimal          @db.Decimal(14, 2)
  gstAmount  Decimal          @default(0) @db.Decimal(14, 2)
  totalAmount Decimal         @db.Decimal(14, 2)

  paidAmount   Decimal @default(0) @db.Decimal(14, 2)
  waivedAmount Decimal @default(0) @db.Decimal(14, 2)
  /// Signed: positive increases the due, negative reduces it.
  adjustmentAmount  Decimal @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal @db.Decimal(14, 2)

  status SubscriptionInvoiceStatus @default(pending)

  isLegacyCarryForward Boolean @default(false)
  /// Plan prices / GMV bands used at generation, for immutability and audit.
  settingsSnapshot     Json    @default("{}")
  generatedBy          InvoiceGeneratedBy @default(system)
  notes                String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   FoodRestaurant                @relation(fields: [restaurantId], references: [id])
  transactions FoodSubscriptionTransaction[]

  @@unique([restaurantId, billingMonth])
  @@index([billingMonth, status])
  @@index([status, outstandingAmount])
  @@map("food_subscription_invoices")
}

/// Append-only audit trail of subscription billing activity. Never updated or
/// deleted — corrections are new adjustment rows.
model FoodSubscriptionTransaction {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  restaurantId String @db.VarChar(24)
  invoiceId    String @db.VarChar(24)
  billingMonth String @db.VarChar(16)

  type SubscriptionTxnType
  /// Signed for adjustments; positive for payments, deductions, waivers, invoice totals.
  amount            Decimal @db.Decimal(14, 2)
  outstandingAfter  Decimal @db.Decimal(14, 2)
  invoiceStatusAfter String

  processedByRole ProcessorRole @default(SYSTEM)
  processedById   String?       @db.VarChar(24)
  processedByName String        @default("")

  remarks  String @default("")
  metadata Json   @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant FoodRestaurant          @relation(fields: [restaurantId], references: [id])
  invoice    FoodSubscriptionInvoice @relation(fields: [invoiceId], references: [id])

  @@index([restaurantId, createdAt(sort: Desc)])
  @@index([invoiceId, createdAt])
  @@index([billingMonth])
  @@index([type])
  @@map("food_subscription_transactions")
}

