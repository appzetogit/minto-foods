model FoodUser {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  phone        String  @unique @db.VarChar(20)
  countryCode  String  @default("+91") @db.VarChar(8)
  name         String?
  email        String?
  profileImage String  @default("")

  fcmTokens      String[]
  fcmTokenMobile String[]

  dateOfBirth DateTime?
  anniversary DateTime?
  gender      Gender    @default(unset)

  referralCode  String?
  referredById  String? @db.VarChar(24)
  referralCount Int     @default(0)

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)
  role       String  @default("USER")

  rating       Decimal @default(0) @db.Decimal(2, 1)
  totalRatings Int     @default(0)

  /// Bumped on login and embedded in the JWT; older tokens are rejected.
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referredBy FoodUser?  @relation("UserReferral", fields: [referredById], references: [id])
  referrals  FoodUser[] @relation("UserReferral")

  addresses     UserAddress[]
  orders        FoodOrder[]
  cart          FoodUserCart?
  favorites     FoodUserFavorite[]
  supportTicket FoodSupportTicket[]
  payments      Payment[]
  refunds       Refund[]
  offerUsages   FoodOfferUsage[]
  safetyReports FoodSafetyEmergencyReport[]

  @@index([referredById])
  @@index([isActive])
  @@map("food_users")
}

/// Was FoodUser.addresses[] — promoted to a table because each entry carried its
/// own _id, its own timestamps and a 2dsphere index.
model UserAddress {
  id     String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)
  userId String @db.VarChar(24)

  label             AddressLabel @default(Home)
  street            String
  additionalDetails String       @default("")
  city              String
  state             String
  zipCode           String       @default("")
  phone             String       @default("")

  /// Read lat/lng; the geography column is trigger-maintained for GIST queries.
  latitude  Float?
  longitude Float?
  location  Unsupported("geography(Point, 4326)")?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user FoodUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("food_user_addresses")
}

model FoodRestaurant {
  id String @id @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @db.VarChar(24)

  restaurantName String
  ownerName      String
  ownerEmail     String?
  ownerPhone     String? @db.VarChar(20)

  /// Derived at write time — the pre('validate') hook moves into the service layer.
  restaurantNameNormalized String?
  ownerPhoneDigits         String? @db.VarChar(15)
  ownerPhoneLast10         String? @db.VarChar(10)
  primaryContactNumber     String? @db.VarChar(20)

  pureVegRestaurant Boolean @default(false)

  addressLine1 String?
  addressLine2 String?
  area         String?
  city         String?
  state        String?
  pincode      String?
  landmark     String?

  cuisines    String[]
  openingTime String?
  closingTime String?
  openDays    String[]

  /// Manual Online/Offline toggle. false = force offline regardless of outlet timings.
  isAcceptingOrders Boolean @default(true)
  /// Legacy, no longer honoured. Cleared whenever the toggle is updated.
  outsideHoursOverride Boolean @default(false)

  panNumber    String?
  nameOnPan    String?
  gstRegistered Boolean @default(false)
  gstNumber    String?
  gstLegalName String?
  gstAddress   String?
  fssaiNumber  String?
  fssaiExpiry  DateTime?

  accountNumber     String?
  ifscCode          String?
  accountHolderName String?
  accountType       String?
  upiId             String?
  upiQrImage        String?

  menuImages    String[]
  coverImages   String[]
  coverImage    String   @default("")
  /// Storefront photos shown to the rider at pickup and on the customer page.
  galleryImages String[]
  profileImage  String?

  fcmTokens      String[]
  fcmTokenMobile String[]

  /// Published location. Read latitude/longitude; `location` is trigger-maintained
  /// for GIST/ST_DWithin and is not selectable through Prisma Client.
  latitude        Float?
  longitude       Float?
  location        Unsupported("geography(Point, 4326)")?
  /// Proposed location awaiting admin approval; the published one stays live.
  pendingLatitude  Float?
  pendingLongitude Float?
  pendingLocation  Unsupported("geography(Point, 4326)")?

  pendingZoneId             String?              @db.VarChar(24)
  locationUpdateStatus      LocationUpdateStatus @default(none)
  locationUpdateRequestedAt DateTime?
  locationUpdateReviewedAt  DateTime?
  locationRejectionReason   String               @default("")

  zoneId        String? @db.VarChar(24)
  businessModel String?

  panImage   String?
  gstImage   String?
  fssaiImage String?

  estimatedDeliveryTime        String?
  estimatedDeliveryTimeMinutes Int?

  featuredDish  String?
  featuredPrice Decimal? @db.Decimal(14, 2)
  offer         String?

  rating       Decimal @default(0) @db.Decimal(2, 1)
  totalRatings Int     @default(0)

  diningEnabled  Boolean @default(false)
  diningMaxGuests Int    @default(6)
  diningType     String  @default("family-dining")

  /// Duplicated by FoodRestaurantMenu.sections in Mongo; both kept as-is.
  menuSections Json @default("[]")

  status          ApprovalStatus @default(pending)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  onboardingFeePaid             Boolean   @default(false)
  onboardingFeeAmount           Decimal   @default(0) @db.Decimal(14, 2)
  onboardingFeePaidAt           DateTime?
  onboardingFeePaymentMethod    String?
  onboardingFeePaymentOrderId   String?
  onboardingFeePaymentId        String?
  onboardingFeePaymentSignature String?

  subscriptionPlan               String?
  subscriptionAmount             Decimal               @default(0) @db.Decimal(14, 2)
  subscriptionPaidAmount         Decimal               @default(0) @db.Decimal(14, 2)
  subscriptionAutoDeductedAmount Decimal               @default(0) @db.Decimal(14, 2)
  subscriptionDueAmount          Decimal               @default(0) @db.Decimal(14, 2)
  subscriptionStatus             SubscriptionDueStatus @default(due)
  subscriptionValidTill          DateTime?

  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone        FoodZone? @relation("RestaurantZone", fields: [zoneId], references: [id])
  pendingZone FoodZone? @relation("RestaurantPendingZone", fields: [pendingZoneId], references: [id])

  orders                FoodOrder[]
  foodItems             FoodItem[]
  addons                FoodAddon[]
  categories            FoodCategory[]              @relation("CategoryOwner")
  createdCategories     FoodCategory[]              @relation("CategoryCreator")
  menu                  FoodRestaurantMenu?
  outletTimings         FoodRestaurantOutletTimings?
  commission            FoodRestaurantCommission?
  supportTickets        FoodRestaurantSupportTicket[]
  withdrawals           FoodRestaurantWithdrawal[]
  subscriptionInvoices  FoodSubscriptionInvoice[]
  subscriptionTxns      FoodSubscriptionTransaction[]
  subscriptionHistory   FoodRestaurantSubscriptionHistory[]
  diningProfile         FoodDiningRestaurant?
  gourmetListing        FoodGourmetRestaurant[]
  foodTransactions      FoodTransaction[]
  userSupportTickets    FoodSupportTicket[]
  emergencyRequests     DeliveryOrderEmergencyRequest[]
  feedback              FeedbackExperience[]
  offers                FoodOffer[]

  @@unique([restaurantNameNormalized, ownerPhoneLast10])
  @@index([ownerPhone])
  @@index([restaurantName])
  @@index([restaurantNameNormalized])
  @@index([city])
  @@index([status, createdAt(sort: Desc)])
  @@index([isAcceptingOrders])
  @@index([zoneId])
  @@index([estimatedDeliveryTimeMinutes])
  @@index([rating])
  @@map("food_restaurants")
}

