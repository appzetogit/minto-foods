# Backend configuration.
#
# Copy to .env and fill in. Everything marked REQUIRED IN PRODUCTION is checked
# at boot by src/config/validateEnv.js — the server refuses to start without it
# rather than failing one customer at a time. Everything else has the default
# shown, and can be left out.
#
# Local development needs only the first two sections.


# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED. See prisma/README.md for the docker compose that provides it.
DATABASE_URL="postgresql://minto:minto@localhost:5433/minto?schema=public"

DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=10
DATABASE_TRANSACTION_MAX_WAIT_MS=5000
DATABASE_TRANSACTION_TIMEOUT_MS=15000


# ── Tokens ────────────────────────────────────────────────────────────────────
# REQUIRED. Long random strings, different from each other, never committed.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

BCRYPT_SALT_ROUNDS=10


# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
SOCKET_PORT=5001
HTTP_REQUEST_TIMEOUT_MS=30000

# Public origin of the web app, used to build shareable links.
FRONTEND_URL=
# Overrides FRONTEND_URL for referral invites only, when those point at a
# marketing or deep-link host instead.
REFERRAL_LINK_BASE_URL=

# Which origins may open a socket. The default is '*' — set this in production
# unless you intend any site on the internet to be able to connect.
SOCKET_CORS_ORIGIN=*


# ── OTP and SMS ───────────────────────────────────────────────────────────────
# SMS_INDIA_HUB_* are REQUIRED IN PRODUCTION: without them no OTP is delivered
# and nobody can log in.
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=

# Development only. Fixes every OTP at 1234 AND returns it in the login
# response, so anyone can sign in as any phone number. Production refuses to
# start with this on.
USE_DEFAULT_OTP=false

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600


# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# All three are REQUIRED IN PRODUCTION. Without the webhook secret every
# callback is refused, so orders are paid for and never confirmed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

COD_ENABLED=true


# ── Push notifications (Firebase) ─────────────────────────────────────────────
# One of these two is REQUIRED IN PRODUCTION — a path to the service account
# JSON, or the JSON itself. Without it restaurants are never told about new
# orders.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

FCM_DEFAULT_CHANNEL_ID=default
FCM_NEW_ORDER_CHANNEL_ID=new_orders
FCM_NEW_ORDER_TTL_SECONDS=300

# Handed to web clients that render their own Firebase messaging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=


# ── Maps ──────────────────────────────────────────────────────────────────────
# Delivery distance and routing. Absent, distances fall back to straight-line.
GOOGLE_MAPS_API_KEY=


# ── Uploads ───────────────────────────────────────────────────────────────────
# Files are written to disk and served by nginx, not by Node.
UPLOAD_STORAGE_ROOT=uploads          # production default: /var/www/uploads
UPLOAD_BASE_URL=/uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_WEBP_QUALITY=90
UPLOAD_WEBP_MAX_WIDTH=2560
UPLOAD_RATE_LIMIT_WINDOW=15
UPLOAD_RATE_LIMIT_MAX=60


# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=2500
# Per IP+phone — the brute-force limit on one account.
AUTH_RATE_LIMIT_WINDOW=15
AUTH_RATE_LIMIT_MAX=30
# Per IP across all auth routes — the enumeration backstop. High enough not to
# fire for a shared office address doing ordinary logins.
AUTH_IP_CEILING_MAX=300


# ── Redis and queues ──────────────────────────────────────────────────────────
# Redis switches itself on when a URL is present. BullMQ needs Redis.
REDIS_URL=
BULLMQ_ENABLED=false
SERVER_BACKGROUND_JOBS_ENABLED=true
SERVER_QUEUE_BOOTSTRAP_ENABLED=true


# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Admin password reset. Ordinary users authenticate by SMS.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=


# ── Operations ────────────────────────────────────────────────────────────────
DISPLAY_TIME_ZONE=Asia/Kolkata
RESTAURANT_TIMEZONE=Asia/Kolkata
# Orders nobody marked delivered are closed after this many hours.
AUTO_DELIVER_AFTER_HOURS=6
# A rider's location older than this is not trusted for dispatch.
DISPATCH_STALE_GPS_MS=120000

# Optional. Signs the /api/deploy webhook; absent, that route is not mounted.
DEPLOY_SECRET=


# ── Mobile app links ──────────────────────────────────────────────────────────
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
ANDROID_PLAY_STORE_URL=
IOS_APP_STORE_URL=
