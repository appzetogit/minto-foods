{
  "name": "switcheats-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Switcheats Product Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker:order": "node src/queues/workers/order.worker.js",
    "worker:tracking": "node src/queues/workers/tracking.worker.js",
    "worker:maintenance": "node src/queues/workers/maintenance.worker.js",
    "test": "node scripts/require-db.mjs && node scripts/check-prisma-fields.mjs && node --import ./scripts/test-env.mjs --test --test-concurrency=3 \"src/**/*.test.js\"",
    "db:migrate": "prisma migrate deploy && node prisma/apply-constraints.mjs && prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "start:scheduler": "node scripts/run-scheduled-jobs.js",
    "start:socket": "node socket-server.js",
    "db:constraints": "node prisma/apply-constraints.mjs",
    "db:reset": "prisma migrate reset --force && node prisma/apply-constraints.mjs",
    "db:migration:new": "node prisma/new-migration.mjs",
    "check:fields": "node scripts/check-prisma-fields.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongo-sanitize": "^1.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.2",
    "razorpay": "^2.9.2",
    "redis": "^4.6.14",
    "sharp": "^0.35.1",
    "socket.io": "^4.7.5",
    "xss-clean": "^0.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.2",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=22"
  }
}
