# Copy to .env.uat before `npm run build -- --mode uat`. Vite inlines these at build
# time — changing them means rebuilding, not restarting.
# NEVER use localhost values in a production build.

# ── API (required) ───────────────────────────────────────────────────────────
# The API lives on its own host, so the browser calls it cross-origin: this
# origin must also appear in the backend's CORS_ORIGINS or every request fails
# preflight.
VITE_API_BASE_URL=https://uat.api.mintofood.com/api/v1

# Uploaded images, served by nginx from /var/www/minto-uat/uploads.
VITE_UPLOAD_BASE_URL=https://uat.api.mintofood.com/uploads

# ── Maps ─────────────────────────────────────────────────────────────────────
# Restrict this key to https://uat.admin.mintofood.com/* in the Google console —
# a build ships it to every browser.
VITE_GOOGLE_MAPS_API_KEY=

# ── Firebase (web push + messaging) ──────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=
